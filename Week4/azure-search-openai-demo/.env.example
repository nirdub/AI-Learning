# ============================================================
# RAG Chatbot - Local Development Environment Variables
# ============================================================
# Copy this file to: .azure/tdai-rag-chatbot/.env
# (create the folders if they don't exist)
# Then fill in the values provided by your trainer.
#
# The app uses `azd` to load this file at runtime (via load_azd_env()).
# You do NOT need to have azd fully configured — just the .env file in place.
# ============================================================

# Azure environment name (keep as-is)
AZURE_ENV_NAME="tdai-rag-chatbot"

# Azure subscription & tenant (provided by trainer)
AZURE_SUBSCRIPTION_ID=""
AZURE_TENANT_ID=""
AZURE_RESOURCE_GROUP="tdai-learning"
AZURE_LOCATION="australiaeast"

# Azure OpenAI
AZURE_OPENAI_SERVICE=""
AZURE_OPENAI_RESOURCE_GROUP="tdai-learning"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_CHATGPT_DEPLOYMENT="gpt-4.1-mini"
AZURE_OPENAI_CHATGPT_MODEL="gpt-4.1-mini"
AZURE_OPENAI_CHATGPT_DEPLOYMENT_VERSION="2025-04-14"
AZURE_OPENAI_CHATGPT_DEPLOYMENT_SKU="GlobalStandard"
AZURE_OPENAI_EMB_DEPLOYMENT="text-embedding-3-large"
AZURE_OPENAI_EMB_MODEL_NAME="text-embedding-3-large"
AZURE_OPENAI_EMB_DEPLOYMENT_VERSION=1
AZURE_OPENAI_EMB_DIMENSIONS=3072
AZURE_OPENAI_EMB_DEPLOYMENT_SKU="GlobalStandard"
AZURE_OPENAI_LOCATION=""
AZURE_OPENAI_REASONING_EFFORT="medium"

# Azure AI Search
AZURE_SEARCH_SERVICE="ai-search-tdai"
AZURE_SEARCH_SERVICE_LOCATION="eastus"
AZURE_SEARCH_SERVICE_RESOURCE_GROUP="tdai-learning"
AZURE_SEARCH_INDEX="gptkbindex"
AZURE_SEARCH_FIELD_NAME_EMBEDDING="embedding3"
AZURE_SEARCH_SEMANTIC_RANKER="free"
AZURE_SEARCH_USER_ASSIGNED_IDENTITY_RESOURCE_ID=""

# Azure Storage (for documents)
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_CONTAINER="content"
AZURE_STORAGE_LOCATION="eastus"
AZURE_STORAGE_RESOURCE_GROUP="tdai-learning"

# Azure Container Registry (for deployed image — not needed for local run)
AZURE_CONTAINER_REGISTRY_ENDPOINT=""

# Document Intelligence (for PDF parsing)
AZURE_DOCUMENTINTELLIGENCE_SERVICE="tdai-doc-intelligence"
AZURE_DOCUMENTINTELLIGENCE_LOCATION="eastus"
AZURE_DOCUMENTINTELLIGENCE_RESOURCE_GROUP="tdai-learning"

# OpenAI host (keep as-is)
OPENAI_HOST="azure"
AZURE_USE_AUTHENTICATION="false"

# Chat history (optional — leave blank to disable)
AZURE_CHAT_HISTORY_VERSION="cosmosdb-v2"
AZURE_CHAT_HISTORY_DATABASE="chat-database"
AZURE_CHAT_HISTORY_CONTAINER="chat-history-v2"
AZURE_COSMOSDB_ACCOUNT=""

# Cloud ingestion storage (optional)
AZURE_CLOUD_INGESTION_STORAGE_ACCOUNT="tdaistrgacnt"
AZURE_CLOUD_INGESTION_STORAGE_RESOURCE_GROUP="tdai-learning"
USE_CLOUD_INGESTION_ACLS="false"

# Backend URL (only needed if connecting to deployed cloud version)
BACKEND_URI=""
