# Script 1 — Dedicated Speech resource (or Foundry multi-service key)
SPEECH_KEY=your-speech-resource-key-here #foundry multi-service key

# Scripts 2, 3, 4, 5 — Azure AI Foundry (Speech SDK)
FOUNDRY_KEY=your-azure-ai-foundry-key-here #foundry multi-service key
FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
SPEECH_REGION=australiaeast
FOUNDRY_MODEL=gpt-4o-mini

# Scripts 6, 7 — Azure OpenAI Speech resource (gpt-4o-mini-tts / gpt-4o-mini-transcribe)
AZURE_OPENAI_SPEECH_ENDPOINT=https://your-speech-resource.cognitiveservices.azure.com
AZURE_OPENAI_SPEECH_KEY=your-speech-resource-key-here

# Script 8 — Azure Voice Live real-time agent
# VOICELIVE_ENDPOINT: base URL only e.g. https://your-resource.cognitiveservices.azure.com
VOICELIVE_ENDPOINT=your-voicelive-endpoint-here
VOICELIVE_KEY=your-voicelive-key-here
VOICELIVE_MODEL=gpt-5.3-chat
