# ─────────────────────────────────────────────
#  Week 8 Session 2 — Environment Variables
# ─────────────────────────────────────────────

# Azure AI Search (scripts 1 & 2)
# Azure Portal > your AI Search resource > Keys and Endpoint
SEARCH_ENDPOINT=https://<your-search-name>.search.windows.net
QUERY_KEY=<your-query-key>
ADMIN_KEY=<your-admin-key>
INDEX_NAME=<your-index-name>
INDEXER_NAME=<your-indexer-name>
SKILLSET_NAME=<your-skillset-name>

# Azure AI Language — used by setup_search_index.py for NER and key phrases
# Use the same key as your Azure AI Services (Foundry) resource if it is multi-service
LANGUAGE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
LANGUAGE_KEY=<your-key-here>

# Azure AI Foundry project — AIProjectClient (scripts 3, 4)
# Auth: DefaultAzureCredential — run `az login` before executing these scripts
# Endpoint format: https://<resource>.services.ai.azure.com/api/projects/<project-name>
PROJECT_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Azure AI Foundry — OpenAI Responses API direct (scripts 5, 6, 6b)
# Azure AI Foundry > your resource > Keys and Endpoint
# Endpoint format: https://<resource>.openai.azure.com/openai/v1
AZURE_AI_ENDPOINT=https://<your-resource>.openai.azure.com/openai/v1
AZURE_AI_KEY=<your-key-here>
AZURE_AI_MODEL=gpt-4o-mini
