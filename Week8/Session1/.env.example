# Week 8 Session 1 — Document Intelligence & Content Understanding
# Copy this file to .env and fill in your own values.
# Never commit .env to git.

# ── Azure Document Intelligence (scripts 1, 2, 4) ────────────
# Azure Portal > your Document Intelligence resource > Keys and Endpoint
DOC_INTELLIGENCE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
DOC_INTELLIGENCE_KEY=<your-key-here>

# ── Azure AI Content Understanding (script 3) ────────────────
# Use an Azure AI Services (multi-service) resource.
# Supported regions include: East US, West Europe, Australia East, and others.
# The 'businesscardanalyser' analyzer is created automatically on first run.
CONTENT_UNDERSTANDING_ENDPOINT=https://<your-resource-name>.services.ai.azure.com #https://xxx.cognitiveservices.azure.com/ 
CONTENT_UNDERSTANDING_KEY=<your-key-here>
CONTENT_UNDERSTANDING_API_VERSION=2025-11-01 #keeps changing so check version on documentation
ANALYZER_NAME=businesscardanalyser #this is already defined on content understanding
